<?xml version="1.0" encoding="utf-8"?>
<!-- No backups (Android 12+; allowBackup covers older versions): notes are kept safe in the sheet
     music folder instead, and the folder access a backup would restore doesn't survive anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
